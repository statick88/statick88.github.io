{
  "name": "cv-diego",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "pnpm validate:cv && vite build && node scripts/generate-csp.mjs && pnpm export:cv",
    "build:quick": "vite build && node scripts/generate-csp.mjs",
    "build:analyze": "vite build --mode analyze && node scripts/generate-csp.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "vite build --mode analyze",
    "generate:cvs": "node generate-cv-markdown.js && node generate-profile-cvs.js",
    "validate:cv": "tsx scripts/validate-cv.ts",
    "export:cv": "tsx scripts/export-structured.ts"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "js-yaml": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vite": "8.1.0",
    "vitest": "^4.1.9",
    "web-vitals": "^5.3.0"
  }
}
