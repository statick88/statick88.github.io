{
  "name": "cv-diego",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "prepare": "husky",
    "dev": "vite",
    "build": "pnpm validate:cv && vite build && tsx scripts/prerender-cv.ts && node scripts/generate-csp.mjs && pnpm export:cv",
    "build:quick": "vite build && node scripts/generate-csp.mjs",
    "build:analyze": "vite build --mode analyze && node scripts/generate-csp.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "vite build --mode analyze",
    "generate:cvs": "tsx generate-cv-markdown.js && tsx scripts/render-cv-pdfs.ts",
    "validate:cv": "tsx scripts/validate-cv.ts",
    "export:cv": "tsx scripts/export-structured.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "render:cvs": "tsx scripts/render-cv-pdfs.ts"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "js-yaml": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.1.6",
    "vitest": "^4.1.12",
    "web-vitals": "^5.3.0"
  }
}
