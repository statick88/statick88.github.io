#!/usr/bin/env bash
# .husky/pre-commit — Quality Gate
# Runs lint, typecheck, tests, and security audit before every commit

echo "🔍 Running pre-commit quality checks..."

# 1. Security audit (fast — scans staged files)
echo "→ Security audit..."
./scripts/security-audit.sh --staged || exit 1

# 2. Lint
echo "→ Linting..."
pnpm run lint || exit 1

# 3. TypeScript check
echo "→ Typechecking..."
pnpm run typecheck || exit 1

# 4. Run tests
echo "→ Running tests..."
pnpm test || exit 1

echo "✅ All pre-commit checks passed"
